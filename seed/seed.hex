; seed.hex -- the bootstrap seed: a hex assembler, hand-written as raw wasm.
;
; Input (stdin):  lowercase hex digit pairs, whitespace, ';' comments (to the
;                 end of the line), and '{' ... '}', which puts the byte
;                 length of the enclosed output in front of it as a 5-byte
;                 (padded) LEB128 -- what makes hand-writing wasm section and
;                 function sizes bearable.  Nothing else may appear outside
;                 comments, and braces must balance.
; Output (stdout): the bytes.
;
; This file is itself valid input for seed.wasm.  It uses explicit sizes
; rather than braces so that the result is byte-identical to seed.wasm.
;
; memory: [0] input byte  [4] iovec {ptr 0, len 1}  [12] nread
;         [16..] output

00 61 73 6d 01 00 00 00                       ; magic, version 1

01 0c 02                                      ; type section: 2 types
  60 04 7f 7f 7f 7f 01 7f                     ;   0: (i32 i32 i32 i32) -> i32
  60 00 00                                    ;   1: () -> ()

02 44 02                                      ; import section: 2 imports
  16 77 61 73 69 5f 73 6e 61 70 73 68 6f 74 5f 70 72 65 76 69 65 77 31
  07 66 64 5f 72 65 61 64 00 00               ;   func 0 = wasi fd_read
  16 77 61 73 69 5f 73 6e 61 70 73 68 6f 74 5f 70 72 65 76 69 65 77 31
  08 66 64 5f 77 72 69 74 65 00 00            ;   func 1 = wasi fd_write

03 02 01 01                                   ; function section: 1 x type 1
05 03 01 00 10                                ; memory: 16 pages
06 06 01 7f 01 41 00 0b                       ; global section: g0 out = 0 (output length)
07 13 02                                      ; export section
  06 6d 65 6d 6f 72 79 02 00                  ;   "memory"
  06 5f 73 74 61 72 74 00 02                  ;   "_start" = func 2

0a dc 01 01                                   ; code section: 1 body

; func 2: _start -- assemble until '}' (return) or end of input (write the
; output; return).  Recurses for '{'.
; locals: 0 c, 1 p, 2 in-comment, 3 acc (hex digit accumulator)
d9 01 01 04 7f
41 08 41 01 22 03 3a 00 00                    ; [8] = 1 (iovec length); acc = 1
03 40                                         ; loop
  41 00 41 04 41 01 41 0c 10 00 1a            ;   fd_read(0, iovec, 1, &nread); drop
  41 0c 28 02 00 45 04 40                     ;   if nread == 0:
    41 04 41 10 36 02 00                      ;     [4] = iovec {16, out}
    41 08 23 00 36 02 00
    41 01 41 04 41 01 41 0c 10 01 1a          ;     fd_write(1, iovec, 1, &nwritten); drop
    0f                                        ;     return
  0b
  41 00 2d 00 00 21 00                        ;   c = byte
  20 00 41 3b 46 20 02 72                     ;   (c == ';' | comment)
  20 00 41 0a 47 71 22 02                     ;   & c != '\n' -> comment
  20 00 41 21 49 72 0d 00                     ;   if comment | c <= ' ': continue
  20 00 41 fb 00 46 04 40                     ;   if c == '{':
    23 00 41 05 6a 22 01 24 00                ;     p = out += 5
    10 02                                     ;     recurse
    23 00 20 01 6b 41 80 80 80 80 01 72 21 00 ;     c = (out - p) | 1 << 28   (a sentinel)
    03 40                                     ;     do
      20 01 20 00 41 80 01 72 3a 00 0b        ;       [16+p-5] = c | 128
      20 01 41 01 6a 21 01                    ;       p++
      20 00 41 07 76 22 00 41 01 4b 0d 00     ;     while (c >>= 7) > 1   (4 times)
    0b                                        ;     (the fifth byte stays 0)
    0c 01                                     ;     continue
  0b
  20 00 41 fd 00 46 0d 01                     ;   if c == '}': return
  20 03 41 04 74                              ;   acc = c = acc << 4
  20 00 41 30 6b 41 27 70 72                  ;     | (c - '0') % 39   (hex digit)
  22 00 21 03
  20 00 41 ff 01 4b 04 40                     ;   if c > 255 (two digits):
    23 00 20 00 3a 00 10                      ;     [16+out] = c
    23 00 41 01 6a 24 00                      ;     out += 1
    41 01 21 03                               ;     acc = 1
  0b
  0c 00                                       ;   continue
0b
0b
