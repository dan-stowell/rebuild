; compiler.hex -- stage 1: a compiler for "sx", a tiny s-expression language,
; written as raw wasm in the seed's hex format (assemble with seed.wasm).
;
; Reads sx source on stdin, writes a wasm module on stdout.
;
; THE LANGUAGE
;   Every value is an i32 and every expression produces exactly one value.
;   Top level forms:
;     (fn name (params...) (locals...) body...)   function; returns last body value
;     (global name number)                        mutable global
;     (const name number)                         named constant
;   Expressions:
;     123  -7  0x1f  "string" (address of NUL-terminated bytes; \n escape)
;     name                                  local / global / const
;     (if c a [b])  (while c body...)  (do e...)  (set name v)  (return v)
;     (f args...)                           call a function
;     (op args...)                          wasm op, see the OPS table below
;   The program's entry point is (fn main () () ...); a nonzero result traps.
;   Builtin functions: fd_read, fd_write (WASI).  Strings live at 1024+.
;
; HOW THIS FILE IS LAID OUT
;   ';' comments, hex bytes, and '{' '}' for sizes (see seed.hex).  Each line
;   is annotated with what it does; branch depths and local numbers are
;   wasm's.  Function indices:
;     0 fd_read 1 fd_write 2 next 3 emit 4 uleb 5 sleb 6 emitn 7 sbeg 8 send
;     9 streq 10 kw 11 lookup 12 addsym 13 compile 14 seq 15 args 16 skip
;     17 err 18 _start
;   Globals: 0 pos 1 out 2 tok 3 tstart 4 tlen 5 tval 6 nsym 7 dcur 8 nfunc
;     9 nglob 10 nloc
;   Tokens (tok): 0 eof, 1 '(', 2 ')', 3 number, 4 symbol, 5 string
;   Memory: 0x100.. static data, 0x10000 symbols (16 bytes: name ptr, len,
;     kind, value; kind 0 local 1 global 2 const 3+n function with n params),
;     0x20000 global initial values, 0x30000 string data, 0x40000 source,
;     0x80000 output.

00 61 73 6d 01 00 00 00

01 { 07                                    ; types
  60 04 7f 7f 7f 7f 01 7f                  ;   0 (i32 i32 i32 i32) -> i32
  60 00 00                                 ;   1 () -> ()
  60 00 01 7f                              ;   2 () -> i32
  60 01 7f 00                              ;   3 (i32) -> ()
  60 01 7f 01 7f                           ;   4 (i32) -> i32
  60 02 7f 7f 01 7f                        ;   5 (i32 i32) -> i32
  60 02 7f 7f 00                           ;   6 (i32 i32) -> ()
}
02 { 02                                    ; imports
  16 77 61 73 69 5f 73 6e 61 70 73 68 6f 74 5f 70 72 65 76 69 65 77 31
  07 66 64 5f 72 65 61 64 00 00            ;   0 fd_read
  16 77 61 73 69 5f 73 6e 61 70 73 68 6f 74 5f 70 72 65 76 69 65 77 31
  08 66 64 5f 77 72 69 74 65 00 00         ;   1 fd_write
}
03 { 11 01 03 03 03 06 02 03 00 04 02 05 01 01 01 01 01 01 }   ; funcs 2..18
05 { 01 00 10 }                            ; memory: 16 pages
06 { 0b                                    ; 11 globals, all 0
  7f 01 41 00 0b  7f 01 41 00 0b  7f 01 41 00 0b  7f 01 41 00 0b
  7f 01 41 00 0b  7f 01 41 00 0b  7f 01 41 00 0b  7f 01 41 00 0b
  7f 01 41 00 0b  7f 01 41 00 0b  7f 01 41 00 0b
}
07 { 02
  06 6d 65 6d 6f 72 79 02 00               ; "memory"
  06 5f 73 74 61 72 74 00 12               ; "_start" = func 18
}

