; hello world
(const IOV 0)
(global counter 3)
(fn strlen (s) (n)
  (while (load8 (+ s n)) (set n (+ n 1)))
  n)
(fn puts (s) ()
  (store IOV s)
  (store (+ IOV 4) (strlen s))
  (fd_write 1 IOV 1 8))
(fn fact (n) () (if (<= n 1) 1 (* n (fact (- n 1)))))
(fn main () (i)
  (while (> counter 0)
    (puts "hello, world\n")
    (set counter (- counter 1)))
  (if (= (fact 5) 120) (puts "fact ok\n") (puts "fact BAD\n"))
  (if (= -7 (- 0 7)) (puts "neg ok\n"))
  (if (= 0x1f 31) (puts "hex ok\n"))
  0)
