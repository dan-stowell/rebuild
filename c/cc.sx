; cc.sx -- the bootstrap C compiler: c/cc.c, transcribed into sx.
;
; Its only job is to compile cc.c (with libc.c) once; that compiler then
; compiles itself.  So it follows cc.c function for function, and need not
; produce identical output.  C arrays become fixed regions of memory.

(const MAXSRC 1048576) (const MAXTOK 200000) (const MAXSYM 20000)
(const MAXFN 4000) (const MAXREL 100000) (const DATA_BASE 1024)

(const NBUF 0x200)
(const SRC 0x100000)
(const TK 0x200000) (const TV 0x300000) (const TL 0x400000) (const TLINE 0x500000)
(const DATA 0x600000) (const CODE 0x700000) (const OUT 0x800000)
(const RPOS 0xa00000) (const RKIND 0xa80000) (const RVAL 0xb00000)
(const SNAME 0xb80000) (const SLEN 0xba0000) (const SKIND 0xbc0000)
(const STYPE 0xbe0000) (const SVAL 0xc00000) (const SARR 0xc20000)
(const SBSS 0xc40000)
(const FNAME 0xc60000) (const FNLEN 0xc64000) (const FNP 0xc68000)
(const FRET 0xc6c000) (const FDEF 0xc70000) (const FORD 0xc74000)
(const FIMP 0xc78000) (const BYORD 0xc7c000)

(const T_EOF 256) (const T_NUM 257) (const T_STR 258) (const T_ID 259)
(const T_INT 260) (const T_CHAR 261) (const T_VOID 262) (const T_IF 263)
(const T_ELSE 264) (const T_WHILE 265) (const T_FOR 266) (const T_DO 267)
(const T_RETURN 268) (const T_BREAK 269) (const T_CONTINUE 270)
(const T_SIZEOF 271) (const T_ENUM 272) (const T_STATIC 273) (const T_CONST 274)
(const T_EQ 275) (const T_NE 276) (const T_LE 277) (const T_GE 278)
(const T_AND 279) (const T_OR 280) (const T_INC 281) (const T_DEC 282)
(const T_SHL 283) (const T_SHR 284) (const T_ADDA 285) (const T_SUBA 286)
(const T_MULA 287) (const T_DIVA 288) (const T_MODA 289) (const T_ANDA 290)
(const T_ORA 291) (const T_XORA 292) (const T_SHLA 293) (const T_SHRA 294)

(const R_FUNC 1) (const R_BSS 2) (const R_HEAP 3)
(const S_LOCAL 1) (const S_GLOBAL 2) (const S_FUNC 3) (const S_CONST 4)
(const TY_VOID 0) (const TY_CHAR 1) (const TY_INT 2)

(global srclen 0) (global ntok 0) (global tp 0) (global datalen 0)
(global clen 0) (global olen 0) (global to_out 0) (global nrel 0)
(global nsym 0) (global nfn 0) (global ndef 0) (global nimp 0)
(global mainf -1) (global bsslen 0)
(global lv 0) (global lvi 0) (global tmpa 0) (global tmpb 0) (global nloc 0)
(global depth 0) (global brk 0) (global cont 0)

; ------------------------------------------------------------- utilities

(fn ld (a i) () (load (+ a (<< i 2))))
(fn st (a i v) () (store (+ a (<< i 2)) v))
(fn sc (i) () (load8 (+ SRC i)))
(fn tk (i) () (ld TK i))

(fn sys_read (buf n) ()
  (store 0 buf) (store 4 n)
  (if (fd_read 0 0 1 8) (return -1))
  (load 8))

(fn sys_write (fd buf n) ()
  (store 0 buf) (store 4 n)
  (if (fd_write fd 0 1 8) (return -1))
  (load 8))

(fn cstrlen (s) (n) (while (load8 (+ s n)) (set n (+ n 1))) n)

(fn same (a b n) (i)
  (while (< i n)
    (if (!= (load8 (+ a i)) (load8 (+ b i))) (return 0))
    (set i (+ i 1)))
  1)

(fn eputs (s) () (sys_write 2 s (cstrlen s)))

(fn eputnum (n) (i)
  (set i 15)
  (if (= n 0) (return (eputs "0")))
  (store8 (+ NBUF i) 0)
  (while (> n 0)
    (set i (- i 1))
    (store8 (+ NBUF i) (+ 48 (% n 10)))
    (set n (/ n 10)))
  (eputs (+ NBUF i)))

(fn die (msg) ()
  (eputs "cc: line ") (eputnum (ld TLINE tp)) (eputs ": ") (eputs msg) (eputs "\n")
  (trap))

; ----------------------------------------------------------------- lexer

(fn isdig (c) () (<u (- c 48) 10))
(fn isid (c) ()
  (| (<u (- c 97) 26) (| (<u (- c 65) 26) (| (= c 95) (isdig c)))))
(fn hexval (c) ()
  (if (isdig c) (- c 48)
    (if (<u (- c 97) 6) (- c 87)
      (if (<u (- c 65) 6) (- c 55) -1))))

(fn keyword (p n) (k t i)
  (set k "int char void if else while for do return break continue sizeof enum static const ")
  (set t T_INT)
  (while (load8 k)
    (set i 0)
    (while (!= (load8 (+ k i)) 32) (set i (+ i 1)))
    (if (= i n) (if (same (+ SRC p) k n) (return t)))
    (set k (+ k (+ i 1)))
    (set t (+ t 1)))
  T_ID)

(fn escape (c) ()
  (if (= c 110) 10 (if (= c 116) 9 (if (= c 114) 13 (if (= c 48) 0 c)))))

(fn dbyte (v) () (store8 (+ DATA datalen) v) (set datalen (+ datalen 1)))

(fn punct (i c) (k c1 ps)
  (set ps "==!=<=>=&&||++--<<>>+=-=*=/=%=&=|=^=")
  (set c1 (sc (+ i 1)))
  (if (& (| (= c 60) (= c 62)) (& (= c1 c) (= (sc (+ i 2)) 61)))
    (return (do (st TK ntok (if (= c 60) T_SHLA T_SHRA)) (+ i 3))))
  (while (if (load8 (+ ps k))
           (not (& (= (load8 (+ ps k)) c) (= (load8 (+ ps (+ k 1))) c1)))
           0)
    (set k (+ k 2)))
  (if (load8 (+ ps k))
    (do (st TK ntok (+ T_EQ (/ k 2))) (+ i 2))
    (do (st TK ntok c) (+ i 1))))

(fn lex1 (i line) (c v k)
  (if (>= ntok (- MAXTOK 1)) (die "too many tokens"))
  (st TLINE ntok line)
  (set c (sc i))
  (if (isdig c) (do
      (if (& (= c 48) (| (= (sc (+ i 1)) 120) (= (sc (+ i 1)) 88)))
        (do (set i (+ i 2))
            (while (>= (hexval (sc i)) 0)
              (set v (+ (* v 16) (hexval (sc i))))
              (set i (+ i 1))))
        (while (isdig (sc i))
          (set v (+ (* v 10) (- (sc i) 48)))
          (set i (+ i 1))))
      (st TK ntok T_NUM) (st TV ntok v))
  (if (isid c) (do
      (set k i)
      (while (isid (sc i)) (set i (+ i 1)))
      (st TK ntok (keyword k (- i k))) (st TV ntok k) (st TL ntok (- i k)))
  (if (= c 39) (do                                  ; character literal
      (set c (sc (+ i 1)))
      (set i (+ i 2))
      (if (= c 92) (do (set c (escape (sc i))) (set i (+ i 1))))
      (set i (+ i 1))
      (st TK ntok T_NUM) (st TV ntok c))
  (if (= c 34) (do                                  ; string literal
      (set i (+ i 1))
      (st TK ntok T_STR) (st TV ntok (+ DATA_BASE datalen))
      (while (!= (sc i) 34)
        (if (= (sc i) 0) (die "unterminated string"))
        (set c (sc i)) (set i (+ i 1))
        (if (= c 92) (do (set c (escape (sc i))) (set i (+ i 1))))
        (dbyte c))
      (set i (+ i 1))
      (dbyte 0))
    (set i (punct i c))))))
  (set ntok (+ ntok 1))
  i)

(fn lex () (i line c)
  (set line 1)
  (while (!= (set c (sc i)) 0)
    (if (= c 10) (do (set line (+ line 1)) (set i (+ i 1)))
    (if (| (= c 32) (| (= c 9) (= c 13))) (set i (+ i 1))
    (if (| (= c 35) (& (= c 47) (= (sc (+ i 1)) 47)))   ; # or //
      (while (if (sc i) (!= (sc i) 10) 0) (set i (+ i 1)))
    (if (& (= c 47) (= (sc (+ i 1)) 42))                ; /*
      (do (set i (+ i 2))
          (while (if (sc i) (not (& (= (sc i) 42) (= (sc (+ i 1)) 47))) 0)
            (if (= (sc i) 10) (set line (+ line 1)))
            (set i (+ i 1)))
          (set i (+ i 2)))
      (set i (lex1 i line)))))))
  (st TK ntok T_EOF) (st TLINE ntok line))

(fn accept (t) () (if (= (tk tp) t) (do (set tp (+ tp 1)) 1) 0))
(fn expect (t) () (if (not (accept t)) (die "syntax error")))

; -------------------------------------------------------------- emitting

(fn emit (b) ()
  (if to_out
    (do (store8 (+ OUT olen) b) (set olen (+ olen 1)))
    (do (store8 (+ CODE clen) b) (set clen (+ clen 1)))))
(fn uleb (v) ()
  (while (& v -128) (emit (| (& v 127) 128)) (set v (>>u v 7)))
  (emit v))
(fn sleb (v) (b)
  (while 1
    (set b (& v 127))
    (set v (>> v 7))
    (if (| (& (= v 0) (= (& b 64) 0)) (& (= v -1) (!= (& b 64) 0)))
      (return (emit b)))
    (emit (| b 128))))
(fn pad5 (v) ()
  (emit (| (& v 127) 128)) (emit (| (& (>> v 7) 127) 128))
  (emit (| (& (>> v 14) 127) 128)) (emit (| (& (>> v 21) 127) 128))
  (emit (& (>> v 28) 15)))
(fn patch5 (b p v) ()
  (store8 (+ b p) (| (& v 127) 128))
  (store8 (+ b (+ p 1)) (| (& (>> v 7) 127) 128))
  (store8 (+ b (+ p 2)) (| (& (>> v 14) 127) 128))
  (store8 (+ b (+ p 3)) (| (& (>> v 21) 127) 128))
  (store8 (+ b (+ p 4)) (& (>> v 28) 15)))
(fn emit2 (a b) () (emit a) (emit b))
(fn emit3 (a b c) () (emit a) (emit b) (emit c))
(fn iconst (v) () (emit 0x41) (sleb v))

(fn reloc (kind v) ()
  (if (>= nrel MAXREL) (die "too many relocations"))
  (st RPOS nrel clen) (st RKIND nrel kind) (st RVAL nrel v)
  (set nrel (+ nrel 1))
  (pad5 0))

; --------------------------------------------------------------- symbols

(fn lookup (p n) (i)
  (set i (- nsym 1))
  (while (>= i 0)
    (if (= (ld SLEN i) n) (if (same (+ SRC (ld SNAME i)) (+ SRC p) n) (return i)))
    (set i (- i 1)))
  -1)

(fn addsym (p n kind type v) ()
  (if (>= nsym MAXSYM) (die "too many symbols"))
  (st SNAME nsym p) (st SLEN nsym n) (st SKIND nsym kind) (st STYPE nsym type)
  (st SVAL nsym v) (st SARR nsym 0) (st SBSS nsym 0)
  (set nsym (+ nsym 1))
  (- nsym 1))

(fn nameis (p n s) () (if (= n (cstrlen s)) (same (+ SRC p) s n) 0))

(fn skind (s) () (if (< s 0) 0 (ld SKIND s)))

; ----------------------------------------------------------------- types

(fn isptr (t) () (>= t 4))
(fn tsize (t) () (if (<= t TY_CHAR) 1 4))

(fn istype (i) (t)
  (set t (tk i))
  (| (= t T_INT) (| (= t T_CHAR) (| (= t T_VOID) (| (= t T_STATIC) (= t T_CONST))))))

(fn basetype () (t)
  (while (| (accept T_STATIC) (accept T_CONST)))
  (if (accept T_INT) (set t TY_INT)
    (if (accept T_CHAR) (set t TY_CHAR)
      (if (accept T_VOID) (set t TY_VOID) (die "expected a type"))))
  (while (accept T_CONST))
  t)

(fn stars (t) () (while (accept 42) (set t (+ t 4))) t)

; ----------------------------------------------------------- expressions

(fn eload (t) () (if (= t TY_CHAR) (emit3 0x2c 0 0) (emit3 0x28 2 0)))
(fn estore (t) () (if (= t TY_CHAR) (emit3 0x3a 0 0) (emit3 0x36 2 0)))
(fn rv (t) ()
  (if (= lv 1) (do (emit 0x20) (uleb lvi))
    (if (= lv 2) (eload t)))
  (set lv 0))
(fn sext (t) ()
  (if (= t TY_CHAR) (do (iconst 24) (emit 0x74) (iconst 24) (emit 0x75))))
(fn scale (t) () (if (!= (tsize t) 1) (do (iconst (tsize t)) (emit 0x6c))))
(fn lget (i) () (emit 0x20) (uleb i))
(fn lset (i) () (emit 0x21) (uleb i))
(fn ltee (i) () (emit 0x22) (uleb i))

(fn call (p n) (s f np)
  (if (nameis p n "__builtin_trap")
    (return (do (expect 40) (expect 41) (emit 0) TY_VOID)))
  (if (nameis p n "__memory_size")
    (return (do (expect 40) (expect 41) (emit2 0x3f 0) TY_INT)))
  (if (nameis p n "__memory_grow")
    (return (do (expect 40) (rv (assign)) (expect 41) (emit2 0x40 0) TY_INT)))
  (if (nameis p n "__heap_base")
    (return (do (expect 40) (expect 41) (emit 0x41) (reloc R_HEAP 0) (+ TY_CHAR 4))))
  (set s (lookup p n))
  (if (!= (skind s) S_FUNC) (die "call of undeclared function"))
  (set f (ld SVAL s))
  (expect 40)
  (if (not (accept 41)) (do
    (rv (assign)) (set np 1)
    (while (accept 44) (rv (assign)) (set np (+ np 1)))
    (expect 41)))
  (if (!= np (ld FNP f)) (die "wrong number of arguments"))
  (emit 0x10) (reloc R_FUNC f)
  (set lv 0)
  (ld FRET f))

(fn primary () (t s p n)
  (set t (tk tp))
  (set lv 0)
  (if (= t T_NUM) (return (do (set tp (+ tp 1)) (iconst (ld TV (- tp 1))) TY_INT)))
  (if (= t T_STR) (return (do (set tp (+ tp 1)) (iconst (ld TV (- tp 1))) (+ TY_CHAR 4))))
  (if (= t 40) (return (do (set tp (+ tp 1)) (set t (expr)) (expect 41) t)))
  (if (!= t T_ID) (die "expected an expression"))
  (set p (ld TV tp)) (set n (ld TL tp)) (set tp (+ tp 1))
  (if (= (tk tp) 40) (return (call p n)))
  (set s (lookup p n))
  (if (< s 0) (die "undeclared identifier"))
  (if (= (ld SKIND s) S_CONST) (return (do (iconst (ld SVAL s)) TY_INT)))
  (if (= (ld SKIND s) S_LOCAL) (return (do (set lv 1) (set lvi (ld SVAL s)) (ld STYPE s))))
  (if (!= (ld SKIND s) S_GLOBAL) (die "not a variable"))
  (emit 0x41)
  (if (ld SBSS s) (reloc R_BSS (ld SVAL s)) (sleb (ld SVAL s)))
  (if (ld SARR s) (return (+ (ld STYPE s) 4)))
  (set lv 2)
  (ld STYPE s))

(fn incdec (t d post) ()
  (if (isptr t) (set d (* d (tsize (- t 4)))))
  (if (= lv 1)
    (if post
      (do (lget lvi) (lget lvi) (iconst d) (emit 0x6a) (sext t) (lset lvi))
      (do (lget lvi) (iconst d) (emit 0x6a) (sext t) (ltee lvi)))
    (if (= lv 2)
      (do (ltee tmpa) (lget tmpa) (eload t)
          (if post
            (do (ltee tmpb) (iconst d) (emit 0x6a) (estore t) (lget tmpb))
            (do (iconst d) (emit 0x6a) (ltee tmpb) (estore t) (lget tmpb))))
      (die "not an lvalue")))
  (set lv 0)
  t)

(fn postfix () (t)
  (set t (primary))
  (while 1
    (if (accept 91)
      (do (rv t)
          (if (not (isptr t)) (die "subscript of a non-pointer"))
          (rv (expr))
          (scale (- t 4))
          (emit 0x6a)
          (expect 93)
          (set t (- t 4)) (set lv 2))
      (if (accept T_INC) (set t (incdec t 1 1))
        (if (accept T_DEC) (set t (incdec t -1 1))
          (return t))))))

(fn unary () (t)
  (set t (tk tp))
  (if (accept 45) (return
    (if (= (tk tp) T_NUM)
      (do (set tp (+ tp 1)) (iconst (- 0 (ld TV (- tp 1)))) (set lv 0) TY_INT)
      (do (iconst 0) (rv (unary)) (emit 0x6b) TY_INT))))
  (if (accept 33) (return (do (rv (unary)) (emit 0x45) TY_INT)))
  (if (accept 126) (return (do (rv (unary)) (iconst -1) (emit 0x73) TY_INT)))
  (if (accept 42) (return (do
    (set t (unary)) (rv t)
    (if (not (isptr t)) (die "dereference of a non-pointer"))
    (set lv 2)
    (- t 4))))
  (if (accept 38) (return (do
    (set t (unary))
    (if (!= lv 2) (die "cannot take this address"))
    (set lv 0)
    (+ t 4))))
  (if (accept T_INC) (return (incdec (unary) 1 0)))
  (if (accept T_DEC) (return (incdec (unary) -1 0)))
  (if (accept T_SIZEOF) (return (do
    (expect 40) (set t (stars (basetype))) (expect 41)
    (iconst (tsize t)) (set lv 0)
    TY_INT)))
  (if (= t 40) (if (istype (+ tp 1)) (return (do
    (set tp (+ tp 1)) (set t (stars (basetype))) (expect 41)
    (rv (unary))
    t))))
  (postfix))

(fn prec (t) ()
  (if (= t T_OR) 1
  (if (= t T_AND) 2
  (if (= t 124) 3
  (if (= t 94) 4
  (if (= t 38) 5
  (if (| (= t T_EQ) (= t T_NE)) 6
  (if (| (| (= t 60) (= t 62)) (| (= t T_LE) (= t T_GE))) 7
  (if (| (= t T_SHL) (= t T_SHR)) 8
  (if (| (= t 43) (= t 45)) 9
  (if (| (= t 42) (| (= t 47) (= t 37))) 10
    0)))))))))))

(fn opcode (t) ()
  (if (| (= t 43) (= t T_ADDA)) 0x6a
  (if (| (= t 45) (= t T_SUBA)) 0x6b
  (if (| (= t 42) (= t T_MULA)) 0x6c
  (if (| (= t 47) (= t T_DIVA)) 0x6d
  (if (| (= t 37) (= t T_MODA)) 0x6f
  (if (| (= t 38) (= t T_ANDA)) 0x71
  (if (| (= t 124) (= t T_ORA)) 0x72
  (if (| (= t 94) (= t T_XORA)) 0x73
  (if (| (= t T_SHL) (= t T_SHLA)) 0x74
  (if (| (= t T_SHR) (= t T_SHRA)) 0x75
  (if (= t T_EQ) 0x46
  (if (= t T_NE) 0x47
  (if (= t 60) 0x48
  (if (= t 62) 0x4a
  (if (= t T_LE) 0x4c
    0x4e))))))))))))))))

(fn binary (minp) (t op p t2 addsub)
  (set t (unary))
  (while 1
    (set op (tk tp)) (set p (prec op))
    (if (| (= p 0) (< p minp)) (return t))
    (set tp (+ tp 1))
    (rv t)
    (if (= op T_AND)
      (do (emit2 0x04 0x7f) (rv (binary (+ p 1))) (iconst 0) (emit 0x47)
          (emit 0x05) (iconst 0) (emit 0x0b)
          (set t TY_INT))
    (if (= op T_OR)
      (do (emit2 0x04 0x7f) (iconst 1)
          (emit 0x05) (rv (binary (+ p 1))) (iconst 0) (emit 0x47) (emit 0x0b)
          (set t TY_INT))
      (do (set t2 (binary (+ p 1))) (rv t2)
          (set addsub (| (= op 43) (= op 45)))
          (if (& addsub (& (isptr t) (not (isptr t2)))) (scale (- t 4)))
          (emit (opcode op))
          (if (& (= op 45) (& (isptr t) (isptr t2)))
            (do (if (!= (tsize (- t 4)) 1) (do (iconst (tsize (- t 4))) (emit 0x6d)))
                (set t TY_INT))
            (if (not (& addsub (isptr t))) (set t TY_INT))))))))

(fn cond () (t)
  (set t (binary 1))
  (if (not (accept 63)) (return t))
  (rv t)
  (emit2 0x04 0x7f)
  (set t (expr)) (rv t)
  (expect 58)
  (emit 0x05)
  (rv (cond))
  (emit 0x0b)
  t)

(fn assign () (t op i)
  (set t (cond))
  (set op (tk tp))
  (if (& (!= op 61) (| (< op T_ADDA) (> op T_SHRA))) (return t))
  (set tp (+ tp 1))
  (if (= lv 1)
    (do (set i lvi)
        (if (!= op 61) (lget i))
        (rv (assign))
        (if (!= op 61) (do
          (if (& (isptr t) (| (= op T_ADDA) (= op T_SUBA))) (scale (- t 4)))
          (emit (opcode op))))
        (sext t) (ltee i))
    (if (= lv 2)
      (do (if (!= op 61) (do (ltee tmpa) (lget tmpa) (eload t)))
          (rv (assign))
          (if (!= op 61) (do
            (if (& (isptr t) (| (= op T_ADDA) (= op T_SUBA))) (scale (- t 4)))
            (emit (opcode op))))
          (ltee tmpb) (estore t) (lget tmpb))
      (die "not an lvalue")))
  (set lv 0)
  t)

(fn expr () () (assign))

(fn cunary () (s v)
  (if (accept 45) (return (- 0 (cunary))))
  (if (accept 126) (return (^ (cunary) -1)))
  (if (accept 33) (return (not (cunary))))
  (if (accept 40) (return (do (set v (cexpr)) (expect 41) v)))
  (if (accept T_SIZEOF) (return (do (expect 40) (set v (tsize (stars (basetype)))) (expect 41) v)))
  (if (= (tk tp) T_NUM) (return (do (set tp (+ tp 1)) (ld TV (- tp 1)))))
  (if (= (tk tp) T_ID) (do
    (set s (lookup (ld TV tp) (ld TL tp)))
    (if (= (skind s) S_CONST) (return (do (set tp (+ tp 1)) (ld SVAL s))))))
  (die "expected a constant")
  0)

(fn cbinary (minp) (v op p r)
  (set v (cunary))
  (while 1
    (set op (tk tp)) (set p (prec op))
    (if (| (= p 0) (< p minp)) (return v))
    (set tp (+ tp 1))
    (set r (cbinary (+ p 1)))
    (set v
      (if (= op 43) (+ v r)
      (if (= op 45) (- v r)
      (if (= op 42) (* v r)
      (if (= op 47) (/ v r)
      (if (= op 37) (% v r)
      (if (= op 38) (& v r)
      (if (= op 124) (| v r)
      (if (= op 94) (^ v r)
      (if (= op T_SHL) (<< v r)
      (if (= op T_SHR) (>> v r)
      (if (= op T_EQ) (= v r)
      (if (= op T_NE) (!= v r)
      (if (= op 60) (< v r)
      (if (= op 62) (> v r)
      (if (= op T_LE) (<= v r)
      (if (= op T_GE) (>= v r)
      (if (= op T_AND) (& (!= v 0) (!= r 0))
        (| (!= v 0) (!= r 0))))))))))))))))))))))

(fn cexpr () () (cbinary 1))

; ------------------------------------------------------------ statements

(fn discard (t) ()
  (if (| (= lv 2) (& (= lv 0) (!= t TY_VOID))) (emit 0x1a))
  (set lv 0))

(fn decl () (bt t i going)
  (set bt (basetype))
  (set going 1)
  (while going
    (set t (stars bt))
    (if (!= (tk tp) T_ID) (die "expected a name"))
    (if (= (tk (+ tp 1)) 91) (die "local arrays are not supported"))
    (set i nloc) (set nloc (+ nloc 1))
    (addsym (ld TV tp) (ld TL tp) S_LOCAL t i)
    (set tp (+ tp 1))
    (if (accept 61) (do (rv (assign)) (sext t) (lset i)) (do (iconst 0) (lset i)))
    (set going (accept 44)))
  (expect 59))

(fn forstmt () (top step n save)
  (expect 40)
  (if (not (accept 59)) (do (discard (expr)) (expect 59)))
  (emit2 0x02 0x40) (emit2 0x03 0x40) (set depth (+ depth 2))
  (set brk (- depth 1)) (set top depth)
  (if (not (accept 59)) (do
    (rv (expr)) (expect 59)
    (emit2 0x45 0x0d) (uleb (- depth brk))))
  (set step tp)
  (while (| (> n 0) (!= (tk tp) 41))
    (if (= (tk tp) 40) (set n (+ n 1)))
    (if (= (tk tp) 41) (set n (- n 1)))
    (if (= (tk tp) T_EOF) (die "unterminated for"))
    (set tp (+ tp 1)))
  (set tp (+ tp 1))
  (emit2 0x02 0x40) (set depth (+ depth 1)) (set cont depth)
  (stmt)
  (emit 0x0b) (set depth (- depth 1))
  (if (!= (tk step) 41) (do (set save tp) (set tp step) (discard (expr)) (set tp save)))
  (emit 0x0c) (uleb (- depth top))
  (emit2 0x0b 0x0b) (set depth (- depth 2)))

(fn stmt () (save ob oc top)
  (set ob brk) (set oc cont)
  (if (accept 123) (do
    (set save nsym)
    (while (not (accept 125)) (if (istype tp) (decl) (stmt)))
    (set nsym save))
  (if (accept T_IF) (do
    (expect 40) (rv (expr)) (expect 41)
    (emit2 0x04 0x40) (set depth (+ depth 1))
    (stmt)
    (if (accept T_ELSE) (do (emit 0x05) (stmt)))
    (emit 0x0b) (set depth (- depth 1)))
  (if (accept T_WHILE) (do
    (emit2 0x02 0x40) (emit2 0x03 0x40) (set depth (+ depth 2))
    (set brk (- depth 1)) (set cont depth)
    (expect 40) (rv (expr)) (expect 41)
    (emit2 0x45 0x0d) (uleb (- depth brk))
    (stmt)
    (emit 0x0c) (uleb (- depth cont))
    (emit2 0x0b 0x0b) (set depth (- depth 2)))
  (if (accept T_DO) (do
    (emit2 0x02 0x40) (emit2 0x03 0x40) (emit2 0x02 0x40) (set depth (+ depth 3))
    (set brk (- depth 2)) (set top (- depth 1)) (set cont depth)
    (stmt)
    (emit 0x0b) (set depth (- depth 1))
    (expect T_WHILE) (expect 40) (rv (expr)) (expect 41) (expect 59)
    (emit 0x0d) (uleb (- depth top))
    (emit2 0x0b 0x0b) (set depth (- depth 2)))
  (if (accept T_FOR) (forstmt)
  (if (accept T_RETURN) (do
    (if (not (accept 59)) (do (rv (expr)) (expect 59)))
    (emit 0x0f))
  (if (accept T_BREAK) (do (expect 59) (emit 0x0c) (uleb (- depth brk)))
  (if (accept T_CONTINUE) (do (expect 59) (emit 0x0c) (uleb (- depth cont)))
  (if (not (accept 59)) (do (discard (expr)) (expect 59)))))))))))
  (set brk ob) (set cont oc))

; ------------------------------------------------------------- top level

(fn function (ret p n) (s f np save t body locs going)
  (set s (lookup p n))
  (if (= (skind s) S_FUNC)
    (set f (ld SVAL s))
    (do (if (>= nfn MAXFN) (die "too many functions"))
        (set f nfn) (set nfn (+ nfn 1))
        (addsym p n S_FUNC ret f)
        (st FNAME f p) (st FNLEN f n) (st FRET f ret) (st FDEF f 0)))
  (if (nameis p n "main") (set mainf f))
  (expect 40)
  (set save nsym)
  (if (& (= (tk tp) T_VOID) (= (tk (+ tp 1)) 41)) (set tp (+ tp 1)))
  (if (not (accept 41)) (do
    (set going 1)
    (while going
      (set t (stars (basetype)))
      (if (= (tk tp) T_ID) (do (addsym (ld TV tp) (ld TL tp) S_LOCAL t np) (set tp (+ tp 1))))
      (set np (+ np 1))
      (set going (accept 44)))
    (expect 41)))
  (st FNP f np)
  (if (!= (tk tp) 123) (return (do (set nsym save) 0)))
  (if (ld FDEF f) (die "function redefined"))
  (st FDEF f 1) (st FORD f ndef) (st BYORD ndef f) (set ndef (+ ndef 1))
  (set tmpa np) (set tmpb (+ np 1)) (set nloc (+ np 2)) (set depth 0)
  (set body clen) (pad5 0)
  (emit 1) (set locs clen) (pad5 0) (emit 0x7f)
  (stmt)
  (if (!= ret TY_VOID) (iconst 0))
  (emit 0x0b)
  (patch5 CODE locs (- nloc np))
  (patch5 CODE body (- (- clen body) 5))
  (set nsym save)
  1)

(fn defglobal (t p n) (len s v a)
  (if (accept 91) (do (set len (cexpr)) (expect 93)))
  (if (accept 61)
    (do (if len (die "array initializers are not supported"))
        (if (= (tk tp) T_STR) (do (set v (ld TV tp)) (set tp (+ tp 1))) (set v (cexpr)))
        (set a (tsize t))
        (while (% datalen a) (set datalen (+ datalen 1)))
        (set s (addsym p n S_GLOBAL t (+ DATA_BASE datalen)))
        (dbyte v)
        (if (= a 4) (do (dbyte (>> v 8)) (dbyte (>> v 16)) (dbyte (>> v 24)))))
    (do (while (% bsslen 4) (set bsslen (+ bsslen 1)))
        (set s (addsym p n S_GLOBAL t bsslen))
        (st SBSS s 1) (st SARR s len)
        (set bsslen (+ bsslen (* (if len len 1) (tsize t)))))))

(fn enumdecl () (v i going)
  (accept T_ID)
  (expect 123)
  (set going 1)
  (while (if going (not (accept 125)) 0)
    (if (!= (tk tp) T_ID) (die "expected a name"))
    (set i tp) (set tp (+ tp 1))
    (if (accept 61) (set v (cexpr)))
    (addsym (ld TV i) (ld TL i) S_CONST TY_INT v)
    (set v (+ v 1))
    (if (not (accept 44)) (do (expect 125) (set going 0))))
  (expect 59))

(fn toplevel () (bt t p n)
  (while (!= (tk tp) T_EOF)
    (if (accept T_ENUM) (enumdecl)
      (do
        (set bt (basetype))
        (set t (stars bt))
        (if (!= (tk tp) T_ID) (die "expected a name"))
        (set p (ld TV tp)) (set n (ld TL tp)) (set tp (+ tp 1))
        (if (= (tk tp) 40)
          (if (not (function t p n)) (expect 59))
          (do
            (defglobal t p n)
            (while (accept 44)
              (set t (stars bt))
              (if (!= (tk tp) T_ID) (die "expected a name"))
              (set tp (+ tp 1))
              (defglobal t (ld TV (- tp 1)) (ld TL (- tp 1))))
            (expect 59)))))))

; ---------------------------------------------------------------- output

(fn section (id) () (emit id) (pad5 0) (- olen 5))
(fn endsection (s) () (patch5 OUT s (- (- olen s) 5)))
(fn name (s n) (i) (uleb n) (while (< i n) (emit (load8 (+ s i))) (set i (+ i 1))))

(fn finish () (f i s v bss heap)
  (if (< mainf 0) (die "no main function"))
  (if (not (ld FDEF mainf)) (die "no main function"))
  (while (< f nfn)
    (if (not (ld FDEF f)) (do (st FIMP f nimp) (set nimp (+ nimp 1))))
    (set f (+ f 1)))
  (set bss (+ DATA_BASE datalen))
  (while (% bss 16) (set bss (+ bss 1)))
  (set heap (+ bss bsslen))
  (while (% heap 16) (set heap (+ heap 1)))
  (while (< i nrel)
    (set v (ld RVAL i))
    (if (= (ld RKIND i) R_FUNC) (set v (if (ld FDEF v) (+ nimp (ld FORD v)) (ld FIMP v)))
      (if (= (ld RKIND i) R_BSS) (set v (+ bss v)) (set v heap)))
    (patch5 CODE (ld RPOS i) v)
    (set i (+ i 1)))

  (set to_out 1)
  (emit 0) (emit 0x61) (emit 0x73) (emit 0x6d) (emit 1) (emit 0) (emit 0) (emit 0)
  (set s (section 1))
  (uleb (+ nfn 1))
  (set i 0)
  (while (< i (+ nfn 1))
    (if (= i nfn) (emit3 0x60 0 0)
      (do (set f (if (< i nimp) -1 (ld BYORD (- i nimp))))
          (if (< f 0) (do (set f 0) (while (| (ld FDEF f) (!= (ld FIMP f) i)) (set f (+ f 1)))))
          (emit 0x60) (uleb (ld FNP f))
          (set v 0)
          (while (< v (ld FNP f)) (emit 0x7f) (set v (+ v 1)))
          (if (= (ld FRET f) TY_VOID) (emit 0) (emit2 1 0x7f))))
    (set i (+ i 1)))
  (endsection s)
  (set s (section 2))
  (uleb nimp)
  (set f 0)
  (while (< f nfn)
    (if (not (ld FDEF f)) (do
      (name "wasi_snapshot_preview1" 22)
      (name (+ SRC (ld FNAME f)) (ld FNLEN f))
      (emit 0) (uleb (ld FIMP f))))
    (set f (+ f 1)))
  (endsection s)
  (set s (section 3))
  (uleb (+ ndef 1))
  (set i 0) (while (<= i ndef) (uleb (+ nimp i)) (set i (+ i 1)))
  (endsection s)
  (set s (section 5))
  (emit2 1 0) (uleb (+ (/ heap 65536) 1))
  (endsection s)
  (set s (section 7))
  (uleb 2)
  (name "memory" 6) (emit2 2 0)
  (name "_start" 6) (emit 0) (uleb (+ nimp ndef))
  (endsection s)
  (set s (section 10))
  (uleb (+ ndef 1))
  (set i 0) (while (< i clen) (emit (load8 (+ CODE i))) (set i (+ i 1)))
  (set v olen) (pad5 0)
  (emit 0) (emit 0x10) (uleb (+ nimp (ld FORD mainf)))
  (if (!= (ld FRET mainf) TY_VOID) (do (emit2 0x04 0x40) (emit2 0 0x0b)))
  (emit 0x0b)
  (patch5 OUT v (- (- olen v) 5))
  (endsection s)
  (set s (section 11))
  (uleb 1)
  (emit 0) (iconst DATA_BASE) (emit 0x0b)
  (uleb datalen)
  (set i 0) (while (< i datalen) (emit (load8 (+ DATA i))) (set i (+ i 1)))
  (endsection s))

(fn main () (n)
  (if (< (memgrow 256) 0) (die "out of memory"))
  (while (> (set n (sys_read (+ SRC srclen) (- (- MAXSRC 1) srclen))) 0)
    (set srclen (+ srclen n)))
  (store8 (+ SRC srclen) 0)
  (lex)
  (toplevel)
  (finish)
  (set n 0)
  (while (< n olen) (set n (+ n (sys_write 1 (+ OUT n) (- olen n)))))
  0)
